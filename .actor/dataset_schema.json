{
    "actorSpecification": 1,
    "fields": {
        "id": {
            "type": "string",
            "title": "Result ID",
            "description": "Unique identifier for this radar result"
        },
        "token": {
            "type": "string",
            "title": "Token Symbol",
            "description": "Token symbol or address if symbol unavailable"
        },
        "tokenAddress": {
            "type": "string",
            "title": "Token Address",
            "description": "Solana token address"
        },
        "chain": {
            "type": "string",
            "title": "Blockchain",
            "description": "Blockchain network (currently only solana)"
        },
        "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "When the data was collected (Unix milliseconds)"
        },
        "radarScore": {
            "type": "number",
            "title": "Radar Score",
            "description": "Convergence-based score from 0-100 (not a price prediction)"
        },
        "pattern": {
            "type": "string",
            "title": "Detected Pattern",
            "description": "Identified convergence pattern or null if none"
        },
        "signals": {
            "type": "object",
            "title": "Signal Details",
            "description": "Raw signal values and availability"
        },
        "evidence": {
            "type": "string",
            "title": "Evidence",
            "description": "Human-readable explanation of pattern detection"
        },
        "riskFlags": {
            "type": "string",
            "title": "Risk Flags",
            "description": "Identified risks based on signal analysis"
        },
        "discoveredAt": {
            "type": "string",
            "title": "Discovered At",
            "description": "When this result was generated by the Actor"
        }
    },
    "views": {
        "overview": {
            "title": "Degen Radar Overview",
            "transformation": {
                "fields": [
                    "token",
                    "tokenAddress",
                    "radarScore",
                    "pattern",
                    "timestamp",
                    "evidence",
                    "riskFlags"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "token": {
                        "label": "Token",
                        "format": "text"
                    },
                    "tokenAddress": {
                        "label": "Address",
                        "format": "text"
                    },
                    "radarScore": {
                        "label": "Radar Score",
                        "format": "number"
                    },
                    "pattern": {
                        "label": "Pattern",
                        "format": "text"
                    },
                    "timestamp": {
                        "label": "Time",
                        "format": "date"
                    },
                    "evidence": {
                        "label": "Evidence",
                        "format": "text"
                    },
                    "riskFlags": {
                        "label": "Risk Flags",
                        "format": "text"
                    }
                }
            }
        }
    }
}